{
  "expo": {
    "name": "Cuentas Claras",
    "slug": "finanzas-ana-daniel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finanzaspareja",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.monoga.cuentasclaras",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar comprobantes y facturas desde la galeria.",
          "cameraPermission": "Permite tomar fotos de facturas para analizarlas con IA."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
